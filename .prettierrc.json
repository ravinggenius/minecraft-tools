{
  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-sql"],
  "importOrder": ["^@/(.*)$", "^../", "^./"],
  "importOrderCaseInsensitive": true,
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "quoteProps": "consistent",
  "semi": true,
  "tabWidth": 4,
  "useTabs": true,
  "trailingComma": "none",
  "overrides": [
    {
      "files": ["*.json", "*.md", "*.mdx", "*.toml", "*.yaml", "*.yml"],
      "options": {
        "tabWidth": 2,
        "useTabs": false
      }
    },
    {
      "files": ["*.sql"],
      "options": {
        "parser": "sql",
        "formatter": "sql-formatter",
        "language": "postgresql",
        "database": "postgresql",
        "keywordCase": "upper",
        "dataTypeCase": "upper",
        "functionCase": "lower",
        "identifierCase": "preserve",
        "tabWidth": 1,
        "useTabs": true
      }
    }
  ]
}
