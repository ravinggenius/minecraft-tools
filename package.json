{
  "name": "minecraft-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "premigrate": "src/scripts/next-env psql \"$DATABASE_URL\" -f src/domains/_/bootstrap.sql",
    "migrate": "src/scripts/next-env pgschema apply --file src/domains/main.sql",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint . --ignore-pattern '.next/*' --ignore-pattern 'node_modules/*'",
    "lint:fix": "npm run lint:check -- --fix",
    "load": "npm run load:releases && npm run load:items",
    "load:items": "src/scripts/next-env bun ./src/scripts/import-items.ts",
    "load:releases": "src/scripts/next-env bun ./src/scripts/import-releases.ts",
    "test:integration": "NODE_ENV=test playwright test",
    "test:unit": "NODE_ENV=test src/scripts/next-env vitest"
  },
  "dependencies": {
    "@hapi/iron": "^7.0.1",
    "@roarr/cli": "^5.12.4",
    "@tanstack/react-form": "^1.33.5",
    "camelcase": "^9.0.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "intl-parse-accept-language": "^1.0.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.15",
    "oslo": "^1.2.1",
    "preferred-locale": "^2.0.2",
    "rambda": "^11.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "reformdata": "^0.2.2",
    "roarr": "^7.21.7",
    "search-query-parser": "^1.6.0",
    "server-only": "^0.0.1",
    "slonik": "^49.10.10",
    "slonik-interceptor-query-logging": "^49.10.10",
    "slonik-interceptor-query-normalisation": "^1.1.10",
    "typescript": "^7.0.2",
    "typescript-cookie": "^1.0.6",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@c-ehrlich/eslint-plugin-use-server": "^0.0.6",
    "@next/env": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-slonik": "^1.13.5",
    "eslint-plugin-sql": "^3.2.1",
    "jsdom": "^30.1.2",
    "libpg-query": "^18.1.5",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
